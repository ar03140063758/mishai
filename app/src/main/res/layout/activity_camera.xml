<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0B1E"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mish Camera"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/camera_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#EC4899"
        android:textSize="13sp"
        android:padding="12dp"
        android:text="Camera on hai. Kuch point karo aur 'Photo lo' dabao — Mish batayegi kya dekh rahi hai." />

    <Button
        android:id="@+id/capture_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Photo lo — Mish batayegi"
        android:textSize="16sp"
        android:backgroundTint="#EC4899" />

</LinearLayout>