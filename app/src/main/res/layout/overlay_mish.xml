<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Outer expanding glow / halo (reacts to audio) -->
    <View
        android:id="@+id/halo_view"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_orb_halo" />

    <!-- Mid ripple ring (audio/state reactive) -->
    <View
        android:id="@+id/ripple_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_orb_halo" />

    <!-- Core orb -->
    <View
        android:id="@+id/core_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_orb_idle" />

    <!-- Subtle inner highlight -->
    <View
        android:id="@+id/highlight_view"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:alpha="0.35"
        android:background="@drawable/bg_orb_core" />

</FrameLayout>
