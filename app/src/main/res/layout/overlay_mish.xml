<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expanding halo ring (behind the core) -->
    <View
        android:id="@+id/ring_view"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_gravity="center"
        android:alpha="0.6"
        android:background="@drawable/bg_wave_circle" />

    <!-- Pulsing core circle (Siri-style) -->
    <View
        android:id="@+id/wave_view"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_wave_circle" />

    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_bubble"
        android:text="@string/overlay_bubble_text"
        android:textColor="@color/white"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxWidth="280dp"
        android:textSize="14sp" />

</FrameLayout>